# Example environment variables for artifacts/api-server
# Copy this file to `.env` for local testing and fill real values.
# DO NOT commit real secrets. Use CI/secret manager for production keys.

# ECVRF private key (hex, secp256k1)
VRF_PRIVATE_KEY_HEX=

# Oracle Stellar secret seed (Ed25519) used to sign proof messages
ORACLE_STELLAR_SEED=

# Soroban RPC endpoint (Testnet by default)
SOROBAN_URL=https://soroban-testnet.stellar.org

# Friendbot URL used for testnet funding (optional)
FRIEND_BOT_URL=https://friendbot.stellar.org

# Network identifier: 'testnet' or 'public'
SOROBAN_NETWORK=testnet

# Database connection used by the API (if running the server)
DATABASE_URL=

# For running integration tests locally
RUN_INTEGRATION=0

# Entropy policy
DRAND_ENABLED=0
DRAND_REQUIRED=0

# Signer hardening
REQUIRE_REMOTE_SIGNER=0
ORACLE_SIGNER_URL=
ORACLE_SIGNER_API_KEY=

# KMS configuration (optional)
KMS_PROVIDER=
KMS_AWS_KEY_ID=
AWS_REGION=us-east-1
KMS_AWS_VRF_SECRET_ARN=
KMS_AWS_VRF_KEY_ID=

# Production baseline (must be enforced in production deployments):
# DRAND_REQUIRED=1
# REQUIRE_REMOTE_SIGNER=1
# ORACLE_SIGNER_URL must be configured and reachable
