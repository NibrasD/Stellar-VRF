# ─── Oracle Worker Configuration ─────────────────────────────────────────────
# Copy this to .env and fill in your values.

# Soroban RPC endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed VRF contract address (C... format)
CONTRACT_ADDRESS=CAUL2Y45FMGRSELVIO2QVNNJ4GQ4SQADY2QYTZCRW7K6YINU5QWLD2UT

# Oracle Stellar secret key (S... format) — used to sign transactions & Ed25519 proof signatures
ORACLE_STELLAR_SECRET=S_YOUR_ORACLE_SECRET_KEY_HERE

# Oracle BLS12-381 private key (hex-encoded scalar, 32 bytes)
# Generate with: npm run keygen
ORACLE_BLS_SECRET_KEY=

# ─── drand quicknet configuration ────────────────────────────────────────────
DRAND_CHAIN_HASH=52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
DRAND_API_URL=https://api.drand.sh
DRAND_GENESIS_TIME=1692803367
DRAND_PERIOD=3

# drand group public key (compressed G2, 96 bytes / 192 hex chars).
# This is the `public_key` field from:
#   curl $DRAND_API_URL/$DRAND_CHAIN_HASH/info
# The value below is quicknet. If you change DRAND_CHAIN_HASH you MUST change
# this to match, otherwise every beacon will fail local verification.
DRAND_PUBLIC_KEY=83cf0f2896adee7eb8b5f01fcad3912212c437e0073e911fb90022d3e760183c8c4b450b6a0a6c3ac6a5776a2d1064510d1fec758c921cc22b0e17e63aaf4bcb5ed66304de9cf809bd274ca73bab4af5a6e9c76a4bc09e76eae8991ef5ece45a

# Verify each fetched beacon's BLS signature locally before building a proof.
# Keep this ON in production: the contract re-verifies drand on-chain anyway, so
# this does not change what randomness can be accepted — it stops a compromised
# or buggy relay from making the worker burn CPU and transaction fees on proofs
# that are guaranteed to be rejected. Set to "false" only for debugging.
DRAND_VERIFY_BEACONS=true

# ─── Worker tuning ───────────────────────────────────────────────────────────
# Polling interval for new events (milliseconds)
POLL_INTERVAL_MS=3000

# Maximum retry attempts for fulfill transactions
MAX_RETRIES=3

# Transaction fee in stroops
TX_FEE=1000000

# ─── High Availability (leader election) ─────────────────────────────────────
# Unique per instance (e.g. oracle-primary / oracle-standby).
INSTANCE_ID=oracle-primary

# DISTRIBUTED (multi-server) leader election: set REDIS_URL to a Redis reachable
# by ALL oracle hosts. When set, primary + standby can run on SEPARATE servers
# and coordinate through the shared lease. Leave blank to use the single-host
# file lock (LEADER_LOCK_FILE) instead.
# REDIS_PASSWORD=your_secure_redis_password_here
# REDIS_URL=redis://:${REDIS_PASSWORD}@your-redis-host:6379
LEADER_REDIS_KEY=vrf-oracle:leader

# Single-host fallback lock file (used only when REDIS_URL is empty)
LEADER_LOCK_FILE=/tmp/vrf-oracle.lock

# Lease timing (ms): a standby takes over if the leader stops renewing for TTL.
LEADER_LOCK_TTL_MS=30000
LEADER_HEARTBEAT_MS=10000
LEADER_POLL_MS=5000

# Health/metrics HTTP port (unique per instance on the same host)
HEALTH_PORT=8080
