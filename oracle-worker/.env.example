# ─── Oracle Worker Configuration ─────────────────────────────────────────────
# Copy this to .env and fill in your values.

# Soroban RPC endpoint
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed VRF contract address (C... format)
CONTRACT_ADDRESS=CAUL2Y45FMGRSELVIO2QVNNJ4GQ4SQADY2QYTZCRW7K6YINU5QWLD2UT

# Oracle Stellar secret key (S... format) — used to sign transactions & Ed25519 proof signatures
ORACLE_STELLAR_SECRET=S_YOUR_ORACLE_SECRET_KEY_HERE

# Oracle BLS12-381 private key (hex-encoded scalar, 32 bytes)
# Generate with: npm run keygen
ORACLE_BLS_SECRET_KEY=

# ─── drand quicknet configuration ────────────────────────────────────────────
DRAND_CHAIN_HASH=52db9ba70e0cc0f6eaf7803dd07447a1f5477735fd3f661792ba94600c84e971
DRAND_API_URL=https://api.drand.sh
DRAND_GENESIS_TIME=1692803367
DRAND_PERIOD=3

# drand group public key (compressed G2, 96 bytes / 192 hex chars).
# This is the `public_key` field from:
#   curl $DRAND_API_URL/$DRAND_CHAIN_HASH/info
# The value below is quicknet. If you change DRAND_CHAIN_HASH you MUST change
# this to match, otherwise every beacon will fail local verification.
DRAND_PUBLIC_KEY=83cf0f2896adee7eb8b5f01fcad3912212c437e0073e911fb90022d3e760183c8c4b450b6a0a6c3ac6a5776a2d1064510d1fec758c921cc22b0e17e63aaf4bcb5ed66304de9cf809bd274ca73bab4af5a6e9c76a4bc09e76eae8991ef5ece45a

# Verify each fetched beacon's BLS signature locally before building a proof.
# Keep this ON in production: the contract re-verifies drand on-chain anyway, so
# this does not change what randomness can be accepted — it stops a compromised
# or buggy relay from making the worker burn CPU and transaction fees on proofs
# that are guaranteed to be rejected. "false" is for local debugging only:
# the worker REFUSES to start with it on Mainnet or when NODE_ENV=production
# (the Docker image sets NODE_ENV=production).
DRAND_VERIFY_BEACONS=true

# ─── Worker tuning ───────────────────────────────────────────────────────────
# Polling interval for new events (milliseconds)
POLL_INTERVAL_MS=3000

# Maximum retry attempts for fulfill transactions
MAX_RETRIES=3

# Transaction fee in stroops
TX_FEE=1000000

# ─── High Availability (leader election) ─────────────────────────────────────
# Unique per instance (e.g. oracle-primary / oracle-standby).
INSTANCE_ID=oracle-primary

# DISTRIBUTED (multi-server) leader election: set REDIS_URL to a Redis reachable
# by ALL oracle hosts. When set, primary + standby can run on SEPARATE servers
# and coordinate through the shared lease. Leave blank to use the single-host
# file lock (LEADER_LOCK_FILE) instead.
# REDIS_PASSWORD=your_secure_redis_password_here
# REDIS_URL=redis://:${REDIS_PASSWORD}@your-redis-host:6379
LEADER_REDIS_KEY=vrf-oracle:leader

# Single-host fallback lock file (used only when REDIS_URL is empty)
LEADER_LOCK_FILE=/tmp/vrf-oracle.lock

# Lease timing (ms): a standby takes over if the leader stops renewing for TTL.
LEADER_LOCK_TTL_MS=30000
LEADER_HEARTBEAT_MS=10000
LEADER_POLL_MS=5000

# isLeader() fails closed this many ms BEFORE the lease can expire in Redis,
# measured from when the acquire/renew command was SENT. Default: TTL/5.
# LEADER_LEASE_SAFETY_MS=6000

# After voluntarily giving up leadership (listener keeps crashing), do not
# re-acquire for this long so the standby can take over. Default: 2 x TTL.
# LEADER_RELINQUISH_COOLDOWN_MS=60000

# ─── Listener supervision & reconciliation ───────────────────────────────────
# Listener loop throws (-> supervisor restart) after this many consecutive
# failed event polls.
# LISTENER_MAX_POLL_FAILURES=20

# Supervisor: restart a crashed listener with exponential backoff; after
# LISTENER_MAX_RESTARTS crashes within LISTENER_RESTART_WINDOW_MS the node
# relinquishes leadership so the standby takes over.
# LISTENER_MAX_RESTARTS=5
# LISTENER_RESTART_WINDOW_MS=600000
# LISTENER_RESTART_BASE_MS=2000
# LISTENER_RESTART_MAX_MS=60000

# Reconciliation: on every leadership acquisition and then periodically, read
# the on-chain request Counter and re-check the newest RECONCILE_MAX_SCAN
# request IDs for anything still pending (catches events missed by polling).
# RECONCILE_MAX_SCAN=1000
# RECONCILE_INTERVAL_MS=120000

# /health reports a LEADER as degraded if its listener is not running, or has
# made no progress for HEALTH_LISTENER_STALE_MS (after an initial grace period).
# HEALTH_LISTENER_STALE_MS=120000
# HEALTH_LISTENER_GRACE_MS=60000

# ─── Economic guard (requests that don't pay for themselves) ─────────────────
# The oracle pays ~0.14 XLM per fulfill(). If the contract's on-chain FeeAmount
# is below FULFILL_COST_STROOPS (the live Mainnet instance has FeeAmount = 0),
# the worker limits unpaid work instead of letting spam drain the account.
# Deferred requests stay pending on-chain; requesters can timeout_refund().
#
# Estimated network fee of one fulfill(), in stroops (Mainnet measured
# 1.39–1.49M). Requests whose on-chain fee >= this are served without limit.
# FULFILL_COST_STROOPS=1500000
#
# Never submit if the balance would drop below this (applies to ALL requests).
# MIN_ORACLE_BALANCE_XLM=5
#
# Hard cap on the TOTAL transaction max-fees sent for unpaid, non-allowlisted
# requests per rolling hour. Reserved before EVERY send (retries included).
# With REDIS_URL, it is shared by all instances and survives restarts/failover;
# without Redis it is stored in FEE_GUARD_STATE_FILE (single host only).
# Set 0 to serve only the allowlist.
# UNPAID_BUDGET_XLM_PER_HOUR=1.5
# (Legacy: UNPAID_FULFILL_MAX_PER_HOUR=N is still accepted and becomes a
#  budget of N × FULFILL_COST_STROOPS.)
#
# Spend-ledger location (see above).
# FEE_GUARD_REDIS_KEY=vrf-oracle:unpaid-spend
# FEE_GUARD_STATE_FILE=/var/lib/vrf-oracle/unpaid-spend.json
#
# Only a FeeToken equal to the native XLM SAC is ever treated as "paid"; a fee
# in any other token is unpaid (the worker cannot price it).
#
# Comma-separated requester addresses (G… or C…) always served, e.g. your
# own consumer contract. Not counted against the hourly cap.
# UNPAID_REQUESTER_ALLOWLIST=
#
# How long an oracle-balance reading is reused (ms).
# FEE_GUARD_BALANCE_CACHE_MS=15000

# Health/metrics HTTP port (unique per instance on the same host)
HEALTH_PORT=8080
