{
  "name": "soroban-vrf-oracle-worker",
  "version": "1.0.0",
  "description": "Single-node oracle worker for the Soroban VRF Oracle — listens for request events, fetches drand beacons, generates BLS-VRF proofs, and submits fulfill transactions.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "keygen": "tsx src/keygen.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@stellar/stellar-sdk": "^17.4.0",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
